---
import Layout from '../layouts/Layout.astro';

const experience = [
  {
    role: 'Data Engineering Manager',
    company: 'Beem Credit Union',
    period: 'Jan 2026 – Present',
    bullets: [
      'Lead the design, development, and optimization of scalable data platforms powering digital products and enterprise analytics',
      'Drive strategic direction of data engineering within the Digital Solutions team, ensuring delivery of high-quality, secure, and accessible data solutions',
      'Align data initiatives with broader digital transformation goals to support innovation and data-driven decision-making',
      "Built an AI-powered Dynamics 365 CRM Agent with 12 MCP tools, 8 agentic skills covering full data lifecycle: natural-language CRM querying, PII detection/masking, daily customer data extraction and sentiment analysis, pain points extraction, cross-environment data migration with topological dependency resolution",
      'Built an AI-powered Database Administration Agent for PostgreSQL with automated PII detection, statistical confidence scoring, data masking, and SQL lineage analysis',
    ],
  },
  {
    role: 'Manager, Data Engineering',
    company: 'OCS Ontario Cannabis Store',
    period: 'May 2023 – Jun 2025',
    bullets: [
      'Led a team of data engineers and analysts, managing hiring, mentorship, and performance',
      'Architected and evolved the company\'s data infrastructure with scalable technologies',
      'Established data quality standards and a governance framework with validation and privacy compliance',
      'Led migration from SQL database to a Delta Lakehouse using Synapse Link for Dataverse',
      'Boosted data application performance by 80% by migrating workflows from Azure Logic Apps to Azure Synapse PySpark notebooks',
      'Reduced critical batch job runtime from 8–13 hours to 4 hours through performance tuning',
    ],
  },
  {
    role: 'Data Engineering Manager',
    company: 'Avanade',
    period: 'Mar 2021 – May 2023',
    bullets: [
      'Managed data architecture and project delivery for Dynamics CRM, overseeing environments and code repositories',
      'Delivered 4 CRM data projects and platform migration on schedule',
      'Mentored 5+ data engineers to lead project deliveries',
      'Designed PySpark ingestion framework established as enterprise standard (~$10M CAD)',
    ],
  },
  {
    role: 'Associated Manager, Data Engineering',
    company: 'Accenture',
    period: 'May 2019 – May 2021',
    bullets: [
      'Designed and delivered an extensible Ingestion framework supporting Type 1/2/4 workflows across Hive/SQL, core codebase for four major data projects',
      'Accelerated reporting performance by 4x and slashed time costs by 75% by constructing the first Star Schema Datamart in three weeks',
      'Streamlined ETL pipelines from legacy warehouse to Hive Data Lake, cutting runtime from 17h to under 4h',
      'Eliminated memory issues on Hive data nodes by refactoring legacy ingestion, achieving 80x performance improvement',
    ],
  },
  {
    role: 'Senior Application Developer / Operation Team Lead',
    company: 'Accenture',
    period: 'Sep 2016 – May 2019',
    bullets: [
      'Sustained and enhanced 12 Tier 1 applications across Finance, Treasury, Capital Markets, and Enterprise Solutions',
      'Executed data migration to Dynamics CRM, validating 2000+ vendor profiles',
      'Modernized a Tier 1 application as a containerized solution using Docker and Azure API Gateway',
    ],
  },
  {
    role: 'Senior Application Developer',
    company: 'Algonquin College',
    period: '2015 – 2016',
    bullets: [
      'Analyzed user requirements and delivered end-to-end solutions from coding to deployment',
    ],
  },
  {
    role: 'SQL Database Developer',
    company: 'MontERP',
    period: '2012 – 2015',
    bullets: [
      'Developed stored procedures, UDFs, and triggers with T-SQL for business logic layer',
      'Created processes and packages for EDI and ETL',
      'Optimized database and T-SQL performance',
    ],
  },
];

const education = [
  {
    degree: 'Bachelor of Science, Physics',
    school: 'Nankai University',
  },
];

const certifications = [
  'Microsoft Certified: Azure Data Fundamentals (Jul 2021)',
  'Microsoft Certified: Azure Fundamentals (Jun 2021)',
  'Microsoft Certified Professional (MCP) — Microsoft SQL Server (Nov 2015)',
];

const skillGroups = [
  { category: 'Data & AI', items: ['Azure Synapse', 'Fabric', 'Data Lake', 'PySpark', 'ADF', 'Databricks', 'Hive', 'AI/ML', 'MCP', 'LLM Agents'] },
  { category: 'CRM', items: ['Dynamics 365', 'OData API', 'Azure AD Integration', 'Dataverse', 'Synapse Link'] },
  { category: 'Development', items: ['Python', 'SQL', 'T-SQL', 'C#', '.NET', 'FastMCP', 'Browser-use'] },
  { category: 'Infrastructure', items: ['Airflow', 'PostgreSQL', 'Docker', 'CI/CD', 'Azure DevOps', 'Azure API Gateway'] },
  { category: 'Agentic AI', items: ['MCP Servers', 'LLM Agents', 'Browser Automation', 'RAG', 'Browser-use', 'CloakBrowser'] },
  { category: 'Other', items: ['ETL Pipelines', 'Data Warehousing', 'Delta Lakehouse', 'Data Governance', 'PII Detection'] },
];
---

<Layout title="Resume">
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">Resume</h1>
      <p class="page-desc">
        Joseph Jiao &mdash; Data Engineering Manager &mdash; Ottawa, ON
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container resume-content">
      <section class="resume-section">
        <h2 class="section-title">Experience</h2>
        <div class="timeline">
          {experience.map((job) => (
            <div class="timeline-item">
              <div class="timeline-header">
                <h3 class="timeline-role">{job.role}</h3>
                <span class="timeline-company">{job.company}</span>
              </div>
              <span class="timeline-period">{job.period}</span>
              <ul class="timeline-bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class="resume-section">
        <h2 class="section-title">Education</h2>
        <div class="timeline">
          {education.map((edu) => (
            <div class="timeline-item">
              <div class="timeline-header">
                <h3 class="timeline-role">{edu.degree}</h3>
                <span class="timeline-company">{edu.school}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="resume-section">
        <h2 class="section-title">Certifications</h2>
        <ul class="cert-list">
          {certifications.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </section>

      <section class="resume-section">
        <h2 class="section-title">Skills</h2>
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3 class="skill-category">{group.category}</h3>
            <div class="skills-grid">
              {group.items.map((skill) => (
                <span class="tag skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </section>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 1rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .page-desc {
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .resume-content {
    max-width: 700px;
  }

  .resume-section {
    margin-bottom: 3rem;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .timeline-item {
    border-left: 2px solid var(--border);
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 4px;
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
  }

  .timeline-header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .timeline-role {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .timeline-company {
    font-size: 0.9rem;
    color: var(--accent);
  }

  .timeline-period {
    display: block;
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    margin: 0.25rem 0 0.5rem;
  }

  .timeline-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-bullets li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.15rem 0;
    position: relative;
    padding-left: 1rem;
  }

  .timeline-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .cert-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cert-list li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.3rem 0;
    position: relative;
    padding-left: 1rem;
  }

  .cert-list li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .skill-group {
    margin-bottom: 1.25rem;
  }

  .skill-category {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    font-size: 0.8rem;
    padding: 4px 12px;
  }
</style>
