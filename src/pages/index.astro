---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import projects from '../data/projects.json';

const featuredProjects = projects.slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const experience = [
  {
    role: 'Data Engineering Manager',
    company: 'Beem Credit Union',
    period: 'Jan 2026 – Present',
    bullets: [
      'Lead the design, development, and optimization of scalable data platforms powering digital products and enterprise analytics',
      'Drive strategic direction of data engineering within the Digital Solutions team, ensuring delivery of high-quality, secure, and accessible data solutions',
      'Align data initiatives with broader digital transformation goals to support innovation and data-driven decision-making',
      "Built an AI-powered Dynamics 365 CRM Agent with 12 MCP tools, 8 agentic skills covering full data lifecycle: natural-language CRM querying, PII detection/masking, daily customer data extraction and sentiment analysis, pain points extraction, cross-environment data migration with topological dependency resolution",
      'Built an AI-powered Database Administration Agent for PostgreSQL with automated PII detection, statistical confidence scoring, data masking, and SQL lineage analysis',
    ],
  },
  {
    role: 'Manager, Data Engineering',
    company: 'OCS Ontario Cannabis Store',
    period: 'May 2023 – Jun 2025',
    bullets: [
      'Led a team of data engineers and analysts, managing hiring, mentorship, and performance',
      'Architected and evolved the company\'s data infrastructure with scalable technologies',
      'Established data quality standards and a governance framework with validation and privacy compliance',
      'Led migration from SQL database to Delta Lakehouse using Synapse Link for Dataverse',
      'Boosted data application performance by 80% by migrating workflows from Azure Logic Apps to Azure Synapse PySpark notebooks',
      'Reduced critical batch job runtime from 8–13 hours to 4 hours through performance tuning',
    ],
  },
  {
    role: 'Data Engineering Manager',
    company: 'Avanade',
    period: 'Mar 2021 – May 2023',
    bullets: [
      'Managed data architecture and project delivery for Dynamics CRM, overseeing environments and code repositories',
      'Delivered 4 CRM data projects and platform migration on schedule',
      'Mentored 5+ data engineers to lead project deliveries',
      'Designed PySpark ingestion framework established as enterprise standard (~$10M CAD)',
    ],
  },
  {
    role: 'Associated Manager, Data Engineering',
    company: 'Accenture',
    period: 'May 2019 – May 2021',
    bullets: [
      'Designed and delivered an extensible Ingestion framework supporting Type 1/2/4 workflows across Hive/SQL, core codebase for four major data projects',
      'Accelerated reporting performance by 4x and slashed time costs by 75% by constructing the first Star Schema Datamart in three weeks',
      'Streamlined ETL pipelines from legacy warehouse to Hive Data Lake, cutting runtime from 17h to under 4h',
      'Eliminated memory issues on Hive data nodes by refactoring legacy ingestion, achieving 80x performance improvement',
    ],
  },
  {
    role: 'Senior Application Developer / Operation Team Lead',
    company: 'Accenture',
    period: 'Sep 2016 – May 2019',
    bullets: [
      'Sustained and enhanced 12 Tier 1 applications across Finance, Treasury, Capital Markets, and Enterprise Solutions',
      'Executed data migration to Dynamics CRM, validating 2000+ vendor profiles',
      'Modernized a Tier 1 application as a containerized solution using Docker and Azure API Gateway',
    ],
  },
  {
    role: 'Senior Application Developer',
    company: 'Algonquin College',
    period: '2015 – 2016',
    bullets: [
      'Analyzed user requirements and delivered end-to-end solutions from coding to deployment',
    ],
  },
  {
    role: 'SQL Database Developer',
    company: 'MontERP',
    period: '2012 – 2015',
    bullets: [
      'Developed stored procedures, UDFs, and triggers with T-SQL for business logic layer',
      'Created processes and packages for EDI and ETL',
      'Optimized database and T-SQL performance',
    ],
  },
];
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">
        <span class="hero-greeting">Hello, I'm</span>
        <span class="hero-name">Joseph Jiao</span>
      </h1>
      <p class="hero-subtitle">
        Data Engineering Manager | Ottawa, ON
      </p>
      <div class="hero-links">
        <a href="#experience" class="btn btn-primary">Past Experience</a>
        <a href="/about" class="btn btn-secondary">About Me</a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <h2 class="section-title">Past Experience</h2>
      <div class="experience-list">
        {experience.map((job, i) => (
          <article class="card exp-card">
            <div class="exp-header">
              <div class="exp-header-left">
                <h3 class="exp-role">{job.role}</h3>
                <span class="exp-company">{job.company}</span>
                <span class="exp-period">{job.period}</span>
              </div>
              <button class="exp-toggle" data-index={i} aria-label="Toggle responsibilities">
                <span class="exp-icon">+</span>
              </button>
            </div>
            <div class="exp-bullets" id="exp-bullets-{i}">
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-footer">
        <a href="/projects" class="btn btn-secondary">View All Projects &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Latest Posts</h2>
      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-card card">
            <time class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))}
      </div>
      <div class="section-footer">
        <a href="/blog" class="btn btn-secondary">Read All Posts &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.exp-toggle');
    if (!btn) return;
    const card = btn.closest('.exp-card');
    const bullets = card.querySelector('.exp-bullets');
    const icon = btn.querySelector('.exp-icon');
    const isOpen = bullets.classList.toggle('open');
    icon.textContent = isOpen ? '−' : '+';
    btn.classList.toggle('active', isOpen);
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-greeting {
    font-size: 1.2rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #000;
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn-secondary:hover {
    background: var(--accent);
    color: #000;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .section-footer {
    margin-top: 2rem;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    padding: 1.5rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .post-title {
    font-size: 1.2rem;
    margin: 0.5rem 0;
  }

  .post-title a {
    color: var(--text-primary);
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-card {
    padding: 0;
    overflow: hidden;
  }

  .exp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    gap: 1rem;
  }

  .exp-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .exp-role {
    font-size: 1rem;
    font-weight: 700;
  }

  .exp-company {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .exp-period {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .exp-toggle {
    background: none;
    border: 1px solid var(--border);
    color: var(--accent);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .exp-toggle:hover {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-toggle.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-bullets {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .exp-bullets.open {
    max-height: 500px;
  }

  .exp-bullets ul {
    list-style: none;
    padding: 0 1.5rem 1.25rem;
    margin: 0;
  }

  .exp-bullets li {
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
    position: relative;
    padding-left: 1rem;
    line-height: 1.5;
  }

  .exp-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .hero-name {
      font-size: 2.5rem;
    }
    .exp-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .exp-toggle {
      align-self: flex-end;
    }
  }
</style>
