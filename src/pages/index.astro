---
import fs from 'fs';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import projects from '../data/projects.json';

const featuredProjects = projects.filter((p) => p.title === 'dataverse-to-adls-sync');

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const resumeMd = fs.readFileSync('src/data/resume.md', 'utf-8');

const experience = [];
let current = null;
for (const line of resumeMd.split('\n')) {
  const headerMatch = line.match(/^### (.+) — (.+)$/);
  if (headerMatch) {
    if (current) experience.push(current);
    current = { company: headerMatch[1], role: headerMatch[2], period: '', bullets: [] };
    continue;
  }
  if (current) {
    const periodMatch = line.match(/^\*([^*]+)\*$/);
    if (periodMatch) {
      current.period = periodMatch[1];
      continue;
    }
    const bulletMatch = line.match(/^- (.+)$/);
    if (bulletMatch) {
      current.bullets.push(bulletMatch[1].replace(/\*\*(.+?)\*\*/g, '$1'));
    }
  }
}
if (current) experience.push(current);

const summaries = {
  'Beem Credit Union': 'Lead scalable data platform design and AI agent development for digital products, enterprise analytics, and CRM automation across the full data lifecycle.',
  'OCS Ontario Cannabis Store': 'Led data infrastructure architecture, governance framework, and team mentorship. Delivered 80% performance gains and migrated legacy SQL to Delta Lakehouse.',
  'Avanade': 'Managed Dynamics CRM data architecture and project delivery. Designed PySpark ingestion framework adopted as enterprise standard (~$10M CAD).',
  'Accenture — Associated Manager': 'Delivered extensible ingestion framework and Star Schema Datamart, achieving 4x reporting speed and 80x performance improvement on Hive.',
  'Accenture — Senior Application Developer': 'Sustained 12 Tier-1 applications, executed Dynamics CRM migration validating 2000+ vendor profiles, and modernized apps with Docker and Azure API Gateway.',
  'Algonquin College': 'Delivered end-to-end solutions from requirements analysis through coding, testing, and deployment across development, staging, and production environments.',
  'MontERP': 'Developed T-SQL business logic layer, EDI/ETL packages, and optimized database performance as primary database developer for production systems.',
};

function summaryKey(job) {
  if (job.company === 'Accenture' && job.role.startsWith('Associated')) return 'Accenture — Associated Manager';
  if (job.company === 'Accenture' && job.role.startsWith('Senior Application Developer')) return 'Accenture — Senior Application Developer';
  return job.company;
}
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">
        <span class="hero-greeting">Hello, I'm</span>
        <span class="hero-name">Joseph Jiao</span>
      </h1>
      <p class="hero-subtitle">
        Data Engineering Manager | Ottawa, ON
      </p>
      <div class="hero-links">
        <a href="#experience" class="btn btn-primary">Past Experience</a>
        <a href="/projects" class="btn btn-accent">AI Projects</a>
        <a href="/contact" class="btn btn-secondary">Contact Me</a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <h2 class="section-title">Past Experience</h2>
      <div class="experience-list">
        {experience.map((job) => {
          const key = summaryKey(job);
          const summary = summaries[key] || job.bullets.slice(0, 2).join(' ');
          return (
          <article class="card exp-card">
            <div class="exp-header">
              <div class="exp-title">
                <span class="exp-role">{job.role}</span>
                <span class="exp-sep">—</span>
                <span class="exp-company">{job.company}</span>
              </div>
              <span class="exp-period">{job.period}</span>
            </div>
            <p class="exp-summary">{summary}</p>
            {job.bullets.length > 0 && (
              <div class="exp-extra-wrap">
                <button class="exp-btn" aria-label="Show details">
                  <span class="exp-btn-icon">+</span>
                  <span class="exp-btn-label">details</span>
                </button>
                <div class="exp-extra">
                  <ul>
                    {job.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              </div>
            )}
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-footer">
        <a href="/projects" class="btn btn-secondary">View All Projects &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Latest Posts</h2>
      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-card card">
            <time class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))}
      </div>
      <div class="section-footer">
        <a href="/blog" class="btn btn-secondary">Read All Posts &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.exp-btn');
    if (!btn) return;
    const wrap = btn.closest('.exp-extra-wrap');
    const extra = wrap.querySelector('.exp-extra');
    const icon = btn.querySelector('.exp-btn-icon');
    const label = btn.querySelector('.exp-btn-label');
    const isOpen = extra.classList.toggle('open');
    icon.textContent = isOpen ? '−' : '+';
    label.textContent = isOpen ? 'less' : 'details';
    btn.classList.toggle('active', isOpen);
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-greeting {
    font-size: 1.2rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #000;
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn-secondary:hover {
    background: var(--accent);
    color: #000;
  }

  .btn-accent {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn-accent:hover {
    background: var(--accent);
    color: #000;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .section-footer {
    margin-top: 2rem;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    padding: 1.5rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .post-title {
    font-size: 1.2rem;
    margin: 0.5rem 0;
  }

  .post-title a {
    color: var(--text-primary);
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .exp-card {
    display: flex;
    flex-direction: column;
  }

  .exp-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
  }

  .exp-title {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .exp-role {
    font-size: 1.2rem;
    font-weight: 800;
  }

  .exp-sep {
    color: var(--text-secondary);
    font-size: 0.85rem;
  }

  .exp-company {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--accent);
  }

  .exp-period {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .exp-summary {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .exp-extra-wrap {
    margin-top: 0.5rem;
  }

  .exp-btn {
    background: none;
    border: 1px solid var(--border);
    color: var(--accent);
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    transition: all 0.2s;
  }

  .exp-btn:hover {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-btn.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-btn-icon {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  .exp-extra {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .exp-extra.open {
    grid-template-rows: 1fr;
  }

  .exp-extra > ul {
    overflow: hidden;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .exp-extra li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
    position: relative;
    padding-left: 1rem;
    line-height: 1.6;
  }

  .exp-extra li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
