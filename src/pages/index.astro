---
import fs from 'fs';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import projects from '../data/projects.json';

const featuredProjects = projects.slice(0, 3);

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const resumeMd = fs.readFileSync('src/data/resume.md', 'utf-8');

const experience = [];
let current = null;
for (const line of resumeMd.split('\n')) {
  const headerMatch = line.match(/^### (.+) — (.+)$/);
  if (headerMatch) {
    if (current) experience.push(current);
    current = { company: headerMatch[1], role: headerMatch[2], period: '', bullets: [] };
    continue;
  }
  if (current) {
    const periodMatch = line.match(/^\*([^*]+)\*$/);
    if (periodMatch) {
      current.period = periodMatch[1];
      continue;
    }
    const bulletMatch = line.match(/^- (.+)$/);
    if (bulletMatch) {
      current.bullets.push(bulletMatch[1].replace(/\*\*(.+?)\*\*/g, '$1'));
    }
  }
}
if (current) experience.push(current);
---

<Layout title="Home">
  <section class="hero">
    <div class="container">
      <h1 class="hero-title">
        <span class="hero-greeting">Hello, I'm</span>
        <span class="hero-name">Joseph Jiao</span>
      </h1>
      <p class="hero-subtitle">
        Data Engineering Manager | Ottawa, ON
      </p>
      <div class="hero-links">
        <a href="#experience" class="btn btn-primary">Past Experience</a>
        <a href="/about" class="btn btn-secondary">About Me</a>
      </div>
    </div>
  </section>

  <section class="section" id="experience">
    <div class="container">
      <h2 class="section-title">Past Experience</h2>
      <div class="experience-list">
        {experience.map((job, i) => (
          <article class="card exp-card">
            <div class="exp-header">
              <div class="exp-header-left">
                <h3 class="exp-role">{job.role}</h3>
                <span class="exp-company">{job.company}</span>
                <span class="exp-period">{job.period}</span>
              </div>
              <button class="exp-toggle" data-index={i} aria-label="Toggle responsibilities">
                <span class="exp-icon">+</span>
              </button>
            </div>
            <div class="exp-bullets" id="exp-bullets-{i}">
              <ul>
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Featured Projects</h2>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="section-footer">
        <a href="/projects" class="btn btn-secondary">View All Projects &rarr;</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section-title">Latest Posts</h2>
      <div class="post-list">
        {recentPosts.map((post) => (
          <article class="post-card card">
            <time class="post-date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
            <h3 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            <p class="post-desc">{post.data.description}</p>
          </article>
        ))}
      </div>
      <div class="section-footer">
        <a href="/blog" class="btn btn-secondary">Read All Posts &rarr;</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.exp-toggle');
    if (!btn) return;
    const card = btn.closest('.exp-card');
    const bullets = card.querySelector('.exp-bullets');
    const icon = btn.querySelector('.exp-icon');
    const isOpen = bullets.classList.toggle('open');
    icon.textContent = isOpen ? '−' : '+';
    btn.classList.toggle('active', isOpen);
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: var(--nav-height);
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .hero-greeting {
    font-size: 1.2rem;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .hero-name {
    font-size: 3.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--accent);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #000;
    border: none;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #000;
  }

  .btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn-secondary:hover {
    background: var(--accent);
    color: #000;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .section-footer {
    margin-top: 2rem;
    text-align: center;
  }

  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .post-card {
    padding: 1.5rem;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .post-title {
    font-size: 1.2rem;
    margin: 0.5rem 0;
  }

  .post-title a {
    color: var(--text-primary);
  }

  .post-title a:hover {
    color: var(--accent);
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-card {
    padding: 0;
    overflow: hidden;
  }

  .exp-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    gap: 1rem;
  }

  .exp-header-left {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .exp-role {
    font-size: 1rem;
    font-weight: 700;
  }

  .exp-company {
    font-size: 0.85rem;
    color: var(--accent);
  }

  .exp-period {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .exp-toggle {
    background: none;
    border: 1px solid var(--border);
    color: var(--accent);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .exp-toggle:hover {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-toggle.active {
    background: var(--accent);
    color: #000;
    border-color: var(--accent);
  }

  .exp-bullets {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .exp-bullets.open {
    grid-template-rows: 1fr;
  }

  .exp-bullets > ul {
    overflow: hidden;
  }

  .exp-bullets ul {
    list-style: none;
    padding: 0 1.5rem 1.25rem;
    margin: 0;
  }

  .exp-bullets li {
    font-size: 0.85rem;
    color: var(--text-secondary);
    padding: 0.25rem 0;
    position: relative;
    padding-left: 1rem;
    line-height: 1.5;
  }

  .exp-bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .hero-name {
      font-size: 2.5rem;
    }
    .exp-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .exp-toggle {
      align-self: flex-end;
    }
  }
</style>
