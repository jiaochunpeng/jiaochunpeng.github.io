---
import Layout from '../layouts/Layout.astro';

const skills = [
  'Azure Synapse', 'Fabric', 'Data Lake', 'PySpark', 'ADF', 'Databricks', 'Hive',
  'AI/ML', 'MCP', 'LLM Agents',
  'Dynamics 365', 'OData API', 'Dataverse', 'Synapse Link',
  'Python', 'SQL', 'T-SQL', 'C#', '.NET', 'FastMCP', 'Browser-use',
  'Airflow', 'PostgreSQL', 'Docker', 'CI/CD', 'Azure DevOps',
  'ETL Pipelines', 'Data Warehousing', 'Delta Lakehouse', 'Data Governance', 'PII Detection',
];
---

<Layout title="About">
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">About</h1>
    </div>
  </section>

  <section class="section">
    <div class="container about-content">
      <div class="about-text">
        <p>
          Accomplished Data Leader with over 15 years of experience in end-to-end data lifecycle management,
          AI/ML integration, and enterprise data platform architecture. Specializing in building enterprise-scale
          data warehouses on Azure Fabric/Synapse with Dynamics 365 CRM/F&O data. First in the organization
          to drive AI adoption and build agentic AI solutions.
        </p>
        <p>
          As a Data Engineering Manager at Example Credit Union, I lead the design and optimization of scalable
          data platforms and drive the strategic direction of data engineering within the Digital Solutions team.
          I've built AI-powered agents for CRM operations, database administration, and conversational banking.
        </p>
      </div>

      <div class="about-skills">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          {skills.map((skill) => (
            <span class="tag skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 1rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .about-content {
    max-width: 700px;
  }

  .about-text p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .about-skills {
    margin-top: 3rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    font-size: 0.85rem;
    padding: 6px 16px;
  }
</style>
