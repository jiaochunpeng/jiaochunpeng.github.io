---
import Layout from '../layouts/Layout.astro';

const skills = [
  'JavaScript', 'TypeScript', 'Python', 'Go',
  'React', 'Vue.js', 'Node.js', 'Astro',
  'Docker', 'PostgreSQL', 'Git', 'Linux',
];
---

<Layout title="About">
  <section class="page-header">
    <div class="container">
      <h1 class="page-title">About</h1>
    </div>
  </section>

  <section class="section">
    <div class="container about-content">
      <div class="about-text">
        <p>
          I'm a developer passionate about building things that live on the internet.
          I enjoy creating tools and applications that are both functional and elegant.
        </p>
        <p>
          When I'm not coding, you'll find me exploring new technologies, contributing to
          open source projects, or writing about what I've learned.
        </p>
        <p>
          This site is my little corner of the web — a place to share my work, thoughts,
          and experiments. Feel free to look around!
        </p>
      </div>

      <div class="about-skills">
        <h2 class="section-title">Skills</h2>
        <div class="skills-grid">
          {skills.map((skill) => (
            <span class="tag skill-tag">{skill}</span>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    padding-top: calc(var(--nav-height) + 4rem);
    padding-bottom: 1rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .about-content {
    max-width: 700px;
  }

  .about-text p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .about-skills {
    margin-top: 3rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skill-tag {
    font-size: 0.85rem;
    padding: 6px 16px;
  }
</style>
